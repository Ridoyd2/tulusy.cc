# Canonical site origin (used for SEO metadata, sitemap, robots.txt, and share links)
NEXT_PUBLIC_SITE_URL=https://tulusy.cc

# Server-side FastAPI backend URL for Next.js SSR (/f/[id] metadata and fallback /api rewrites)
BACKEND_URL=http://127.0.0.1:8000

# Leave empty in production so browser API calls use same-origin https://tulusy.cc/api/...
NEXT_PUBLIC_API_URL=
