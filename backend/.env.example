# Application Environment ("development" or "production")
APP_ENV=production

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=https://tulusy.cc,https://www.tulusy.cc

# Converter safety limits (set MAX_FILE_SIZE_MB=95 if proxied behind Cloudflare Free/Pro 100MB limit)
MAX_FILE_SIZE_MB=100
MAX_IMAGE_DIMENSION=16384
MAX_PDF_PAGES=200

# Cloudflare R2 Object Storage Configuration (For 5GB File Hosting)
# 1. Log in to Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
# 2. Create Token with 'Object Read & Write' permissions
# 3. Configure Bucket CORS to allow PUT/GET/HEAD from https://tulusy.cc
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=tulusy

# Optional: Public Custom Domain for your R2 bucket (e.g. https://cdn.tulusy.cc)
R2_PUBLIC_URL=

# Outbound Origin-IP Shield (Protects Hetzner VPS IP during Load Tester & DA Checker runs)
# Option 1: Deploy cloudflare-worker-relay.js and set its URL + secret here
CF_WORKER_RELAY_URL=
CF_WORKER_SECRET=
# Option 2: Or point to local Cloudflare WARP / SOCKS/HTTP proxy (e.g. http://127.0.0.1:40000)
OUTBOUND_PROXY_URL=
PROTECT_VPS_IP=true
